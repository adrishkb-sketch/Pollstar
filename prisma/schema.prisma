datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum PollStatus {
  DRAFT
  ACTIVE
  ENDED
  ON_HOLD
}

enum PollType {
  POLL
  SURVEY
  EXAM
}

enum QuestionType {
  SINGLE
  RANKED
  KNOCKOUT
  MULTIPLE_CHOICE
  SHORT_TEXT
  LONG_TEXT
  RATING
  MULTI_SELECT
  FILE_UPLOAD
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  passwordHash     String
  verified         Boolean     @default(false)
  approvedByAdmin  Boolean     @default(false)
  role             Role        @default(USER)
  polls            Poll[]
  collaborations   PollCollaborator[]
  auditLogs        AuditLog[]
  createdAt        DateTime    @default(now())

  // Profile Onboarding & Verification fields
  profileCompleted     Boolean     @default(false)
  fullName             String?
  avatar               String?
  phoneNumber          String?
  occupation           String?
  institution          String?
  studyField           String?
  gradYear             Int?
  jobTitle             String?
  industry             String?
  educatorSubject      String?
  educatorDept         String?
  researchDomain       String?
  researchPos          String?
  otherDetail          String?
  bio                  String?
  gender               String?
  primaryPurpose       String?

  verificationStatus   String      @default("UNAPPLIED") // UNAPPLIED, PENDING, VERIFIED, REJECTED
  verificationReason   String?
  verificationDocUrl   String?
  isVerifiedUser       Boolean     @default(false)

  // Moderation fields
  isBanned             Boolean     @default(false)
  isSuspended          Boolean     @default(false)
  suspensionUntil      DateTime?
  suspensionReason     String?
  isActivityRestricted Boolean     @default(false)
  twoFactorEnabled     Boolean     @default(false)

  // Subscriptions & Plans
  planId               String?
  plan                 Plan?       @relation(fields: [planId], references: [id], onDelete: SetNull)
  planExpiresAt        DateTime?   // null = lifetime or free
  planBillingCycle     String      @default("MONTHLY") // MONTHLY | QUARTERLY | YEARLY | TWO_YEAR | LIFETIME | ONE_TIME
  isLifetimePlan       Boolean     @default(false)
  domainPlanExpiry     DateTime?   // Set when auto-enrolled via email domain suffix

  // Referral & Wallets System
  referralCode         String?     @unique
  referredById         String?
  referredBy           User?       @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals            User[]      @relation("Referrals")
  wallet               Wallet?
  payoutRequests       PayoutRequest[]
  invoices             Invoice[]
}

model OTP {
  id        String   @id @default(uuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Poll {
  id              String         @id @default(uuid())
  creatorId       String
  creator         User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title           String
  description     String
  posterUrl       String?
  shortCode       String?        @unique
  pollType        PollType       @default(POLL)
  isOpenVoting    Boolean        @default(true)
  isAnonymous     Boolean        @default(true)
  isResultPublic  Boolean        @default(false)
  startTime       DateTime
  endTime         DateTime
  status          PollStatus     @default(DRAFT)
  questions       Question[]
  allowedVoters   AllowedVoter[]
  settings        PollSettings?
  votes           Vote[]
  messages        DirectMessage[]
  collaborators   PollCollaborator[]
  auditLogs       AuditLog[]
  moderations     ContentModeration[]
  invoiceId       String?
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([creatorId])
  @@index([pollType])
  @@index([status])
  @@index([createdAt])
}

model Question {
  id                 String       @id @default(uuid())
  pollId             String
  poll               Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  questionText       String
  type               QuestionType @default(SINGLE)
  pageNumber         Int          @default(1)
  order              Int          @default(1)
  logicRules         Json?        // Stores branching logic rules
  options            Option[]
  correctAnswer      String?      // Stores correct option ID or exact short-text answer
  correctAnswers     Json?        // Stores list of correct options for MULTI_SELECT/Multiple Correct MCQ
  marks              Float?       @default(0.0) // Assigned marks (allow multiples of 0.5)
  inputConstraint    String?      @default("NONE") // NONE, NUMBERS, CHARACTERS
  fileUploadDriveUrl String?      // Drive folder to upload student files
  enableWhiteboard   Boolean      @default(false)

  @@index([pollId])
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String

  @@index([questionId])
}

model Vote {
  id                String   @id @default(uuid())
  pollId            String
  poll              Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userIdentifier    String?  // custom e.g., Roll number
  email             String?
  ipAddress         String
  isp               String?
  device            String?  // Desktop or Mobile
  latitude          Float?
  longitude         Float?
  answers           Json     // JSON string mapping question ID to options/rankings/text
  flaggedSuspicious Boolean  @default(false)
  timeSpent         Int?     // Time spent on survey in seconds
  createdAt         DateTime @default(now())

  @@index([pollId])
  @@index([ipAddress])
}

model AllowedVoter {
  id              String    @id @default(uuid())
  pollId          String
  poll            Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  identifier      String    // e.g. "2021BCS003"
  confirmer1      String    // e.g. "John Doe"
  confirmer2      String?   // e.g. optional secondary confirmation text
  email           String
  phone           String?   // Pre-defined phone number for phone validation
  password        String?   // Pre-defined password assigned to the voter/examinee
  voted           Boolean   @default(false)
  bypassOtpUntil  DateTime?
  bypassRequested Boolean   @default(false)
  voterAuthType   String    @default("GLOBAL") // GLOBAL | EMAIL_OTP | EMAIL_PASSWORD | PHONE_PASSWORD

  @@index([pollId])
  @@index([email])
}

model DirectMessage {
  id               String   @id @default(uuid())
  pollId           String
  poll             Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  senderIdentifier String   // Voter identifier or email
  text             String
  isFromCreator    Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([pollId])
}

model PollCollaborator {
  id        String   @id @default(uuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("CO_EDITOR") // CO_EDITOR, AUDITOR
  createdAt DateTime @default(now())

  @@unique([pollId, userId])
}

model PollSettings {
  id                    String  @id @default(uuid())
  pollId                String  @unique
  poll                  Poll    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  limitOneVotePerUser   Boolean @default(false)
  limitOneVotePerIP     Boolean @default(false)
  limitOneVotePerISP    Boolean @default(false)
  hideResultsUntilEnd   Boolean @default(false)
  publicShowMaps        Boolean @default(true)
  publicShowCharts      Boolean @default(true)
  publicShowStats       Boolean @default(true)
  enableConfidenceSlider Boolean @default(false)
  postSurveyAction      String? // e.g. custom thank you message text
  identifierLabel       String  @default("Roll Number")
  confirmer1Label       String  @default("Student Name")
  confirmer2Label       String  @default("Parent Name")
  enableDragAndDropPodium Boolean @default(false)
  enableHotStreaks       Boolean @default(false)
  enableLiveTicker       Boolean @default(false)
  enableFomoPopups       Boolean @default(false)
  enableSmartDebrief     Boolean @default(false)
  leaderboardVisibility  String  @default("HIDDEN")
  enablePreferenceFlowMap Boolean @default(false)
  enableHeadToHeadMatrix  Boolean @default(false)
  enableConsensusScore    Boolean @default(false)
  enablePolarizationDetector Boolean @default(false)
  enableKingmakerAnalysis Boolean @default(false)
  enableRankHeatmap       Boolean @default(false)
  enableRankConfidence    Boolean @default(false)
  enableScenarioSimulator Boolean @default(false)
  enableTieBreakerEngine  Boolean @default(false)
  rankedTieBreakerRule    String  @default("FIRST_PLACE")
  enableRankCompleteness  Boolean @default(false)
  rankedCompletenessRule  String  @default("PARTIAL")
  enablePodiumResults     Boolean @default(false)
  enableCoalitionFinder   Boolean @default(false)
  enableMinorityProtection Boolean @default(false)
  enableAuditReplay       Boolean @default(false)
  // Single Choice features
  enableQuadraticVoting   Boolean @default(false)
  enableAiProjection      Boolean @default(false)
  enableCohortCrossTab    Boolean @default(false)
  enableSentimentChat     Boolean @default(false)
  enableSwingMap          Boolean @default(false)
  // Knockout features
  enableBracketPredictions Boolean @default(false)
  enableDoubleElimination Boolean @default(false)
  enableUnderdogTracker   Boolean @default(false)
  enableOptionStatsCards  Boolean @default(false)
  enableSuddenDeath       Boolean @default(false)
  
  // Premium Survey Engine Features
  collectEmail            Boolean @default(false)
  postEmailMessage        String?
  enableDropOffTracking   Boolean @default(false)
  enableSemanticAnalysis  Boolean @default(false)
  enableCrossTabulation   Boolean @default(false)
  enableTimeAnalytics     Boolean @default(false)

  // Verification Matrices
  verificationMethod      String  @default("EMAIL") // EMAIL, PHONE
  verificationType        String  @default("OTP")   // OTP, PASSWORD

  // Online Testing / Exam Engine Toggles
  examTimerDuration            Int?              // Exam duration in minutes
  enableProctorCamera          Boolean @default(false)
  enableProctorMicrophone      Boolean @default(false)
  proctorDriveFolderUrl        String?           // Drive folder to save video/audio snapshots
  enableAutoSubmitOnTabLeave   Boolean @default(false)
  enableAutoSubmitOnCacheClear Boolean @default(false)
  enableAutoSubmitOnLeave      Boolean @default(false)
  resultsReleased              Boolean @default(false) // Toggle whether results are visible to examinees

  // Custom White-Label Branding
  enableCustomBranding    Boolean @default(false)
  customLogoUrl           String? // base64 logo string
  customBrandingText      String? // custom header brand text

  // Additional 30 Advanced Features suite toggles
  enableShuffleQuestions       Boolean @default(false)
  enableShuffleOptions         Boolean @default(false)
  enableCopyPasteBlock         Boolean @default(false)
  enableInstantFeedback        Boolean @default(false)
  enableNegativeMarking        Boolean @default(false)
  negativeMarkingPenalty       Float   @default(0.25)
  enableCalculator             Boolean @default(false)
  enableOtpBypass              Boolean @default(false)
  enableStrictTimeBuffer       Boolean @default(false)
  enableTabDepartureSound      Boolean @default(false)

  enableDemographicWeighting   Boolean @default(false)
  enableVpnBlocking            Boolean @default(false)
  enableWriteInOptions         Boolean @default(false)

  enableCustomNavLabels        Boolean @default(false)
  enablePreOnboarding          Boolean @default(false)
  enableBranchingLogic         Boolean @default(false)
  enableDomainRestriction      Boolean @default(false)
  enableDirectInbox            Boolean @default(false)
  enableDraftSave              Boolean @default(false)
  
  // Custom themes & scientific capabilities
  customTheme                  String  @default("MIDNIGHT") // MIDNIGHT, SUNSET, JADE, OCEAN, ALABASTER
  enableSaveAndResumeLater     Boolean @default(false)
  studentWhiteboardDriveUrl    String?
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  adminId   String?
  admin     User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  pollId    String?
  poll      Poll?    @relation(fields: [pollId], references: [id], onDelete: SetNull)
  details   String
  timestamp DateTime @default(now())

  @@index([adminId])
  @@index([pollId])
}

model Plan {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  price           Float    @default(0.0)
  isFree          Boolean  @default(false)
  currency        String   @default("USD") // USD, INR, EUR, GBP, AUTO
  billingCycle    String   @default("MONTHLY") // MONTHLY, YEARLY, ONE_TIME
  planType        String   @default("SUBSCRIPTION") // SUBSCRIPTION, POLL_PACK, SURVEY_PACK, EXAM_PACK, COMBO_PACK
  packQuantity    Int?     // Number of items in pack
  freePerks       Int      @default(0) // Bonus free items with pack
  comboTypes      Json?    // For COMBO_PACK: ["POLL","SURVEY","EXAM"]
  badgeColor      String   @default("#a855f7") // Hex color for user badge
  badgeLabel      String?  // Custom badge text e.g. "Pro", "Enterprise"
  hasFreeTrial    Boolean  @default(false)
  freeTrialDays   Int?     // Trial duration in days
  freeTrialFeatures Json?  // Features available during trial
  pollSubtypes    Json?    // For POLL_PACK: ["MCQ","RANKED","KNOCKOUT","MULTIPLE_CORRECT"]
  isActive        Boolean  @default(true) // Admin can deactivate plans
  features        Json     // JSON object with feature boolean flags
  maxPolls              Int?     @default(10)
  maxSurveys            Int?     @default(10)
  maxExams              Int?     @default(10)
  maxParticipantsPoll   Int?     @default(100)
  maxParticipantsSurvey Int?     @default(100)
  maxParticipantsExam   Int?     @default(100)
  
  // Price slashes & durations pricing configs
  originalPrice   Float?   @default(0.0)
  offerEndDate    DateTime?
  durations       Json?    // Optional JSON pricing configuration per duration

  // Plan validity limits for credit/combo packs
  validityValue   Int?
  validityUnit    String?  // WEEKS, MONTHS
  rank            Int      @default(0)
  addonRank       Int      @default(0) // Separate rank track for ADDON plans only

  users           User[]
  emailDomainMappings EmailDomainMapping[]
  invoices        Invoice[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContactRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("UNREAD") // UNREAD, READ, REPLIED, ARCHIVED
  adminNote String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentModeration {
  id          String   @id @default(uuid())
  pollId      String
  poll        Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  reason      String   // e.g. "Explicit language detected"
  flaggedText String   @db.Text
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pollId])
}

model SiteConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model SupportIssue {
  id          String   @id @default(uuid())
  email       String
  description String
  pageUrl     String?
  status      String   @default("PENDING") // PENDING, RESOLVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Float    @default(0.0)
  totalEarned   Float    @default(0.0)
  totalWithdrawn Float   @default(0.0)
  transactions  Transaction[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Transaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  type        String   // EARNING, PAYOUT
  description String
  createdAt   DateTime @default(now())

  @@index([walletId])
}

model PayoutRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  status      String   // PENDING, CLEARED, REJECTED
  method      String   // UPI, BANK, PAYPAL
  details     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  discountType  String   // FLAT, PERCENTAGE, FREE
  discountValue Float
  startDate     DateTime
  endDate       DateTime
  firstTimeOnly Boolean  @default(false)
  isActive      Boolean  @default(true)
  planId        String?  // Plan wise coupon restriction
  billingCycle  String?  // Subscription duration wise restriction
  maxUses       Int?     // Maximum number of times this coupon can be used
  usesCount     Int      @default(0) // Number of times successfully redeemed
  createdAt     DateTime @default(now())
}

model EmailDomainMapping {
  id             String   @id @default(uuid())
  domain         String   @unique // e.g. "school.edu"
  planId         String
  plan           Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  durationMonths Int?     // null = indefinite; set to give time-limited plan access
  createdAt      DateTime @default(now())
}

model Invoice {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  amountPaid     Float
  couponCode     String?
  billingName    String
  billingAddress String
  billingCity    String
  billingZip     String
  billingPhone   String?
  billingCycle   String   @default("MONTHLY")
  isAddon        Boolean  @default(false)   // true if this invoice is for an add-on plan
  planExpiresAt  DateTime?                  // when the plan purchased here expires
  notes          String?                    // extra notes e.g. "Lifetime upgrade"
  polls          Poll[]
  createdAt      DateTime @default(now())

  paymentStatus   String   @default("COMPLETED") // PENDING, COMPLETED, REJECTED
  upiUtr          String?
  screenshotUrl   String?
  rejectionReason String?  // admin-provided reason when payment is rejected

  @@index([userId])
  @@index([planId])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model JobPosting {
  id           String   @id @default(uuid())
  title        String
  department   String
  location     String
  type         String
  description  String   @db.Text
  requirements String   @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notice {
  id                 String   @id @default(uuid())
  title              String
  content            String   @db.Text
  targetType         String   // "ALL", "REGISTERED", or plan names (e.g. "Free", "Elite")
  priority           String   // "LOW", "MEDIUM", "HIGH"
  publishedAt        DateTime @default(now())
  createdAt          DateTime @default(now())

  referencedNoticeId String?
  referencedNotice   Notice?  @relation("NoticeMentions", fields: [referencedNoticeId], references: [id], onDelete: SetNull)
  mentions           Notice[] @relation("NoticeMentions")

  @@index([referencedNoticeId])
}

model DeletedPoll {
  id        String   @id @default(uuid())
  title     String
  pollType  String   // POLL, SURVEY, EXAM
  creatorId String
  deletedAt DateTime @default(now())

  @@index([creatorId])
}


