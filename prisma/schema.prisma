datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum PollStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum PollType {
  POLL
  SURVEY
  EXAM
}

enum QuestionType {
  SINGLE
  RANKED
  KNOCKOUT
  MULTIPLE_CHOICE
  SHORT_TEXT
  LONG_TEXT
  RATING
  MULTI_SELECT
  FILE_UPLOAD
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  passwordHash     String
  verified         Boolean     @default(false)
  approvedByAdmin  Boolean     @default(false)
  role             Role        @default(USER)
  polls            Poll[]
  collaborations   PollCollaborator[]
  auditLogs        AuditLog[]
  createdAt        DateTime    @default(now())

  // Profile Onboarding & Verification fields
  profileCompleted     Boolean     @default(false)
  fullName             String?
  avatar               String?
  phoneNumber          String?
  occupation           String?
  institution          String?
  studyField           String?
  gradYear             Int?
  jobTitle             String?
  industry             String?
  educatorSubject      String?
  educatorDept         String?
  researchDomain       String?
  researchPos          String?
  otherDetail          String?
  bio                  String?
  gender               String?
  primaryPurpose       String?

  verificationStatus   String      @default("UNAPPLIED") // UNAPPLIED, PENDING, VERIFIED, REJECTED
  verificationReason   String?
  verificationDocUrl   String?
  isVerifiedUser       Boolean     @default(false)

  // Moderation fields
  isBanned             Boolean     @default(false)
  isSuspended          Boolean     @default(false)
  suspensionUntil      DateTime?
  suspensionReason     String?
  isActivityRestricted Boolean     @default(false)

  // Subscriptions & Plans
  planId               String?
  plan                 Plan?       @relation(fields: [planId], references: [id], onDelete: SetNull)
}

model OTP {
  id        String   @id @default(uuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Poll {
  id              String         @id @default(uuid())
  creatorId       String
  creator         User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title           String
  description     String
  posterUrl       String?
  shortCode       String?        @unique
  pollType        PollType       @default(POLL)
  isOpenVoting    Boolean        @default(true)
  isAnonymous     Boolean        @default(true)
  isResultPublic  Boolean        @default(false)
  startTime       DateTime
  endTime         DateTime
  status          PollStatus     @default(DRAFT)
  questions       Question[]
  allowedVoters   AllowedVoter[]
  settings        PollSettings?
  votes           Vote[]
  messages        DirectMessage[]
  collaborators   PollCollaborator[]
  auditLogs       AuditLog[]
  createdAt       DateTime       @default(now())
}

model Question {
  id                 String       @id @default(uuid())
  pollId             String
  poll               Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  questionText       String
  type               QuestionType @default(SINGLE)
  pageNumber         Int          @default(1)
  order              Int          @default(1)
  logicRules         Json?        // Stores branching logic rules
  options            Option[]
  correctAnswer      String?      // Stores correct option ID or exact short-text answer
  correctAnswers     Json?        // Stores list of correct options for MULTI_SELECT/Multiple Correct MCQ
  marks              Float?       @default(0.0) // Assigned marks (allow multiples of 0.5)
  inputConstraint    String?      @default("NONE") // NONE, NUMBERS, CHARACTERS
  fileUploadDriveUrl String?      // Drive folder to upload student files
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
}

model Vote {
  id                String   @id @default(uuid())
  pollId            String
  poll              Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userIdentifier    String?  // custom e.g., Roll number
  email             String?
  ipAddress         String
  isp               String?
  device            String?  // Desktop or Mobile
  latitude          Float?
  longitude         Float?
  answers           Json     // JSON string mapping question ID to options/rankings/text
  flaggedSuspicious Boolean  @default(false)
  timeSpent         Int?     // Time spent on survey in seconds
  createdAt         DateTime @default(now())
}

model AllowedVoter {
  id              String    @id @default(uuid())
  pollId          String
  poll            Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  identifier      String    // e.g. "2021BCS003"
  confirmer1      String    // e.g. "John Doe"
  confirmer2      String?   // e.g. optional secondary confirmation text
  email           String
  phone           String?   // Pre-defined phone number for phone validation
  password        String?   // Pre-defined password assigned to the voter/examinee
  voted           Boolean   @default(false)
  bypassOtpUntil  DateTime?
  bypassRequested Boolean   @default(false)
}

model DirectMessage {
  id               String   @id @default(uuid())
  pollId           String
  poll             Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  senderIdentifier String   // Voter identifier or email
  text             String
  isFromCreator    Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model PollCollaborator {
  id        String   @id @default(uuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([pollId, userId])
}

model PollSettings {
  id                    String  @id @default(uuid())
  pollId                String  @unique
  poll                  Poll    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  limitOneVotePerUser   Boolean @default(false)
  limitOneVotePerIP     Boolean @default(false)
  limitOneVotePerISP    Boolean @default(false)
  hideResultsUntilEnd   Boolean @default(false)
  publicShowMaps        Boolean @default(true)
  publicShowCharts      Boolean @default(true)
  publicShowStats       Boolean @default(true)
  enableConfidenceSlider Boolean @default(false)
  postSurveyAction      String? // e.g. custom thank you message text
  identifierLabel       String  @default("Roll Number")
  confirmer1Label       String  @default("Student Name")
  confirmer2Label       String  @default("Parent Name")
  enableDragAndDropPodium Boolean @default(false)
  enableHotStreaks       Boolean @default(false)
  enableLiveTicker       Boolean @default(false)
  enableFomoPopups       Boolean @default(false)
  enableSmartDebrief     Boolean @default(false)
  leaderboardVisibility  String  @default("HIDDEN")
  enablePreferenceFlowMap Boolean @default(false)
  enableHeadToHeadMatrix  Boolean @default(false)
  enableConsensusScore    Boolean @default(false)
  enablePolarizationDetector Boolean @default(false)
  enableKingmakerAnalysis Boolean @default(false)
  enableRankHeatmap       Boolean @default(false)
  enableRankConfidence    Boolean @default(false)
  enableScenarioSimulator Boolean @default(false)
  enableTieBreakerEngine  Boolean @default(false)
  rankedTieBreakerRule    String  @default("FIRST_PLACE")
  enableRankCompleteness  Boolean @default(false)
  rankedCompletenessRule  String  @default("PARTIAL")
  enablePodiumResults     Boolean @default(false)
  enableCoalitionFinder   Boolean @default(false)
  enableMinorityProtection Boolean @default(false)
  enableAuditReplay       Boolean @default(false)
  // Single Choice features
  enableQuadraticVoting   Boolean @default(false)
  enableAiProjection      Boolean @default(false)
  enableCohortCrossTab    Boolean @default(false)
  enableSentimentChat     Boolean @default(false)
  enableSwingMap          Boolean @default(false)
  // Knockout features
  enableBracketPredictions Boolean @default(false)
  enableDoubleElimination Boolean @default(false)
  enableUnderdogTracker   Boolean @default(false)
  enableOptionStatsCards  Boolean @default(false)
  enableSuddenDeath       Boolean @default(false)
  
  // Premium Survey Engine Features
  collectEmail            Boolean @default(false)
  postEmailMessage        String?
  enableDropOffTracking   Boolean @default(false)
  enableSemanticAnalysis  Boolean @default(false)
  enableCrossTabulation   Boolean @default(false)
  enableTimeAnalytics     Boolean @default(false)

  // Verification Matrices
  verificationMethod      String  @default("EMAIL") // EMAIL, PHONE
  verificationType        String  @default("OTP")   // OTP, PASSWORD

  // Online Testing / Exam Engine Toggles
  examTimerDuration            Int?              // Exam duration in minutes
  enableProctorCamera          Boolean @default(false)
  enableProctorMicrophone      Boolean @default(false)
  proctorDriveFolderUrl        String?           // Drive folder to save video/audio snapshots
  enableAutoSubmitOnTabLeave   Boolean @default(false)
  enableAutoSubmitOnCacheClear Boolean @default(false)
  enableAutoSubmitOnLeave      Boolean @default(false)
  resultsReleased              Boolean @default(false) // Toggle whether results are visible to examinees

  // Custom White-Label Branding
  enableCustomBranding    Boolean @default(false)
  customLogoUrl           String? // base64 logo string
  customBrandingText      String? // custom header brand text

  // Additional 30 Advanced Features suite toggles
  enableShuffleQuestions       Boolean @default(false)
  enableShuffleOptions         Boolean @default(false)
  enableCopyPasteBlock         Boolean @default(false)
  enableInstantFeedback        Boolean @default(false)
  enableNegativeMarking        Boolean @default(false)
  enableCalculator             Boolean @default(false)
  enableOtpBypass              Boolean @default(false)
  enableStrictTimeBuffer       Boolean @default(false)
  enableTabDepartureSound      Boolean @default(false)

  enableDemographicWeighting   Boolean @default(false)
  enableVpnBlocking            Boolean @default(false)
  enableWriteInOptions         Boolean @default(false)

  enableCustomNavLabels        Boolean @default(false)
  enablePreOnboarding          Boolean @default(false)
  enableBranchingLogic         Boolean @default(false)
  enableDomainRestriction      Boolean @default(false)
  enableDirectInbox            Boolean @default(false)
  enableDraftSave              Boolean @default(false)
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  adminId   String?
  admin     User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  pollId    String?
  poll      Poll?    @relation(fields: [pollId], references: [id], onDelete: SetNull)
  details   String
  timestamp DateTime @default(now())
}

model Plan {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  price        Float    @default(0.0)
  billingCycle String   @default("MONTHLY") // MONTHLY, YEARLY, PACK_5, PACK_10, etc.
  features     Json     // JSON object with 13 boolean flags
  users        User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SupportIssue {
  id          String   @id @default(uuid())
  email       String
  description String
  pageUrl     String?
  status      String   @default("PENDING") // PENDING, RESOLVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
